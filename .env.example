# Copie para a Vercel (Settings > Environment Variables). Nunca suba o .env real.
SECRET_KEY=gere-com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Horario: 0 = segunda ... 6 = domingo
LOJA_DIAS=0,1,2,3,4,5,6
LOJA_ABRE=10
LOJA_FECHA=23
# Dominio proprio (opcional)
ALLOWED_HOSTS_EXTRA=
CSRF_TRUSTED_ORIGINS_EXTRA=
